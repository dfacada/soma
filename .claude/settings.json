{
  "permissions": {
    "allow": [
      "Bash(npm run check)",
      "Bash(npm test)",
      "Bash(npm run build)",
      "Bash(npm run lint)",
      "Bash(node docs/checks/prototype-smoke-mobile.js docs/prototype/soma-prototype.html)",
      "Bash(node docs/checks/prototype-smoke-desktop.js docs/prototype/soma-prototype.html)",
      "Bash(git status)",
      "Bash(git diff)",
      "Bash(git diff --stat)",
      "Bash(git log --oneline)",
      "PowerShell(npm run check)",
      "PowerShell(npm test)",
      "PowerShell(git status)",
      "PowerShell(git diff)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\"",
            "timeout": 300,
            "statusMessage": "Checking command"
          }
        ]
      }
    ]
  },
  "skillOverrides": {
    "catalyst-appsail": "off",
    "catalyst-zia": "off",
    "catalyst-smartbrowz": "off",
    "catalyst-nosql": "off",
    "catalyst-signals": "off",
    "catalyst-pricing": "off",
    "catalyst-cache": "off"
  }
}
